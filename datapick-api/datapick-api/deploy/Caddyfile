{$DOMAIN} {
	encode gzip

	# Página y archivo del APK: https://DOMINIO/descargar/
	handle_path /descargar/* {
		root * /srv/release
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		file_server
	}
	redir /descargar /descargar/

	# Todo lo demás va a la API
	handle {
		reverse_proxy api:8000
	}
}
